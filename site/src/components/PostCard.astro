---
import { ArrowUpRight, Clock3 } from "@lucide/astro";
import type { CollectionEntry } from "astro:content";
import { formatDate, readingTime, withBase } from "../utils/site";

interface Props {
  post: CollectionEntry<"posts">;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const slug = post.id.replace(/\.(md|mdx)$/, "");
---

<article class:list={["post-card", { featured }]}>
  <a class="post-cover" href={withBase(`posts/${slug}/`)} tabindex="-1" aria-hidden="true">
    <img src={withBase(post.data.cover)} alt={post.data.coverAlt} loading={featured ? "eager" : "lazy"} />
  </a>
  <div class="post-card-body">
    <div class="post-meta">
      <span>{post.data.category}</span>
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      <span class="read-time"><Clock3 size={14} /> {readingTime(post.body ?? "")} 分钟</span>
    </div>
    <h2><a href={withBase(`posts/${slug}/`)}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="post-card-foot">
      <div class="tag-list">
        {post.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
      </div>
      <a class="read-link" href={withBase(`posts/${slug}/`)} aria-label={`阅读${post.data.title}`}>
        阅读 <ArrowUpRight size={17} />
      </a>
    </div>
  </div>
</article>
