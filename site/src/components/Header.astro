---
import { Menu, Moon, Search, Sun, X } from "@lucide/astro";
import GithubMark from "./GithubMark.astro";
import { siteConfig } from "../config";
import { withBase } from "../utils/site";

const currentPath = Astro.url.pathname;
const isHome = currentPath === withBase();
---

<header class:list={["site-header", { "home-header": isHome }]} data-header>
  <div class="header-inner">
    <a class="brand" href={withBase()} aria-label={`${siteConfig.title}首页`}>
      <span class="brand-mark" aria-hidden="true">N</span>
      <span>{siteConfig.title}</span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {siteConfig.nav.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={{ active: item.href === "" ? currentPath === withBase() : currentPath.includes(`/${item.href}`) }}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="search-trigger" type="button" data-search-open aria-label="搜索文章">
        <Search size={18} stroke-width={1.8} />
        <span>搜索</span>
      </button>
      <a class="icon-button desktop-only" href={siteConfig.github} target="_blank" rel="noreferrer" aria-label="GitHub">
        <GithubMark size={19} />
      </a>
      <button class="icon-button" type="button" data-theme-toggle aria-label="切换深浅色">
        <Sun class="sun-icon" size={19} stroke-width={1.8} />
        <Moon class="moon-icon" size={19} stroke-width={1.8} />
      </button>
      <button class="icon-button menu-button" type="button" data-menu-toggle aria-label="打开导航" aria-expanded="false">
        <Menu class="menu-open-icon" size={21} />
        <X class="menu-close-icon" size={21} />
      </button>
    </div>
  </div>

  <nav class="mobile-nav" data-mobile-nav aria-label="移动端导航">
    {siteConfig.nav.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    <a href={siteConfig.github} target="_blank" rel="noreferrer">GitHub</a>
  </nav>
</header>
